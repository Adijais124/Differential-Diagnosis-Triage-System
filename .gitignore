# Virtual environment
.venv/
venv/
env/
ENV/

# Python cache & build artifacts
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/

# Raw and large processed datasets (Rule 9: never commit large raw data)
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep

# IDE and OS
.vscode/
.idea/
*.swp
*.DS_Store
